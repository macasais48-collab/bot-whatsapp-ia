PROVEEDOR_IA=claude
ANTHROPIC_API_KEY=

# MODELO_IA: deja vacío aquí y pon el valor real solo en tu .env local.
# Recomendado para FAQ (rápido y económico): un modelo de la familia Haiku.
# Identificador verificado en la página oficial de modelos (tabla "Compare models"):
# https://platform.claude.com/docs/en/models/overview -> claude-haiku-5-5
MODELO_IA=

MAX_TURNOS_HISTORIAL=6

# --- WhatsApp Cloud API (Fase 2) ---
# Completa estos valores SOLO en tu .env real, nunca aquí.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
GRAPH_API_VERSION=
WHATSAPP_WABA_ID=
PUERTO=8000

# RUTA_BD: opcional. No es un secreto, así que en Docker se define directamente
# en docker-compose.yml (environment), no aquí. Déjala vacía para usar la ruta
# por defecto (bot_whatsapp.db junto al código).
RUTA_BD=

# RUTA_CACHE_MEDIA: opcional, mismo criterio que RUTA_BD (en Docker se define en
# docker-compose.yml). Déjala vacía para usar la ruta por defecto
# (media_id_cache.json junto al código). Guarda los media id de las imágenes
# subidas a Meta para no resubirlas en cada mensaje.
RUTA_CACHE_MEDIA=

# PERFIL_NEGOCIO: opcional. Valores permitidos: panaderia, camilo, tamales. Vacía =
# panaderia (comportamiento por defecto, usa negocio.md). "camilo" usa
# perfil_camilo.md, "tamales" usa perfil_tamales.md. Un valor distinto a estos
# hace que el bot falle al arrancar.
PERFIL_NEGOCIO=

# NUMERO_DUENO: opcional (pago asistido del perfil "tamales"). Si se configura,
# el bot le envía al dueño el resumen del pedido y botones [Pago recibido]/[No ha
# llegado] cuando un cliente envía el comprobante de un pago por QR. Formato:
# solo dígitos con código de país, sin "+", espacios ni guiones — igual al
# remitente que envía WhatsApp (ej. 573001112233). Completa el valor SOLO en tu
# .env real, nunca aquí.
NUMERO_DUENO=

# PLANTILLA_AVISO_DUENO_NOMBRE / PLANTILLA_AVISO_DUENO_IDIOMA: opcionales. Si
# NUMERO_DUENO está configurada, el aviso al dueño siempre intenta enviarse
# primero con esta plantilla aprobada por Meta (único canal garantizado fuera
# de la ventana de 24 horas); si cualquiera de las dos queda vacía, el bot
# usa el mensaje libre de siempre (como si no estuvieran configuradas). Tú
# creas la plantilla en el WhatsApp Manager (ver docs/plantilla_aviso_dueno.md
# para la especificación exacta) y completas estos dos valores SOLO después
# de que Meta la apruebe, y SOLO en tu .env real, nunca aquí.
PLANTILLA_AVISO_DUENO_NOMBRE=
PLANTILLA_AVISO_DUENO_IDIOMA=

# PLANTILLA_AVISO_PEDIDO_NUEVO_NOMBRE / PLANTILLA_AVISO_PEDIDO_NUEVO_IDIOMA:
# opcionales. Si NUMERO_DUENO está configurada, cada pedido confirmado
# (efectivo o QR pagado) avisa al dueño siempre con esta plantilla aprobada
# por Meta (incluye el teléfono completo del cliente, para que el negocio
# pueda contactarlo y coordinar la entrega); si cualquiera de las dos queda
# vacía, el bot usa el mensaje libre de siempre (como si no estuvieran
# configuradas). Tú creas la plantilla en el WhatsApp Manager (ver
# docs/plantilla_aviso_pedido_nuevo.md para la especificación exacta) y
# completas estos dos valores SOLO después de que Meta la apruebe, y SOLO
# en tu .env real, nunca aquí.
PLANTILLA_AVISO_PEDIDO_NUEVO_NOMBRE=
PLANTILLA_AVISO_PEDIDO_NUEVO_IDIOMA=

# REPORTE_SEMANAL_DIA / REPORTE_SEMANAL_HORA: opcionales. Si NUMERO_DUENO está
# configurada, el bot envía al dueño cada semana un reporte con las cifras de
# la última semana completa (lunes a domingo). Día: lunes, martes, miercoles,
# jueves, viernes, sabado o domingo. Hora: 24 horas, hora de Bogotá (ej. 8 u
# 08:30). Vacías = lunes 8:00. Un valor inválido no impide arrancar: se usa el
# valor por defecto y se registra una advertencia.
REPORTE_SEMANAL_DIA=
REPORTE_SEMANAL_HORA=

# PLANTILLA_REPORTE_SEMANAL_NOMBRE / PLANTILLA_REPORTE_SEMANAL_IDIOMA:
# opcionales. Si las dos están configuradas, el reporte semanal automático se
# envía siempre con esta plantilla aprobada por Meta (llega aunque la ventana
# de 24 horas esté cerrada); si cualquiera de las dos queda vacía, se envía
# como mensaje libre (solo llega si el dueño le escribió al bot en las últimas
# 24 horas). Tú creas la plantilla en el WhatsApp Manager (ver
# docs/plantilla_reporte_semanal.md) y completas estos dos valores SOLO después
# de que Meta la apruebe, y SOLO en tu .env real, nunca aquí.
PLANTILLA_REPORTE_SEMANAL_NOMBRE=
PLANTILLA_REPORTE_SEMANAL_IDIOMA=
